# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Pico SDK builds
firmware/**/build/
*.uf2
*.elf
*.bin
*.map

# LinuxCNC runtime droppings - these are machine state, not configuration
linuxcnc/configs/**/linuxcnc.var
linuxcnc/configs/**/linuxcnc.var.bak
linuxcnc/configs/**/*.log
linuxcnc/configs/**/position*.txt
linuxcnc/configs/**/*.bak

# FreeCAD. The .FCStd is a BUILD ARTIFACT - build.py is the source. Committing
# one invites someone to edit it in the GUI, which the next build silently
# overwrites. STLs are committed, so the parts can be printed without FreeCAD.
hardware/mechanical/**/*.FCStd
hardware/mechanical/**/*.FCStd1
hardware/mechanical/**/*.FCBak

# OS
.DS_Store
Thumbs.db
desktop.ini

# Never commit these: node-specific secrets or site-local overrides
pi/provision/*.local
*.secret

# Screen artifacts - regenerated by `python -m dwinui export` at deploy time,
# so the device can never run a screen that disagrees with the committed SVG.
ui/screens/*.preview.svg
ui/screens/*_screen.py
